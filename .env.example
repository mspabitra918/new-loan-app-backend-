# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_NAME="New Loans"
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Postgres ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Mspabitra1@
DB_NAME=ryer_loans
DB_SSL=false

# ---------- Redis (BullMQ) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Field-level encryption ----------
# 32-byte base64 keys. Generate with: npm run keygen
# KEY MANAGEMENT MUST BE SEPARATE FROM THE APPLICATION DATABASE (GLBA Safeguards).
# In production these come from KMS / Secrets Manager, never from this file.
ENCRYPTION_KEY_ACTIVE=v1
ENCRYPTION_KEY_V1=CHANGE_ME_BASE64_32_BYTES
# Deterministic key used only for blind-index lookup hashes (dedupe on SSN)
BLIND_INDEX_KEY=CHANGE_ME_BASE64_32_BYTES

# ---------- Admin auth ----------
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h
ADMIN_SEED_EMAIL=admin@newloans.com
ADMIN_SEED_PASSWORD=ChangeMe!123

# ---------- Email ----------
# Which sender to use: smtp | mailercloud. Defaults to smtp when SMTP_HOST is set.
MAIL_TRANSPORT=smtp

# ---------- SMTP (nodemailer) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=your_smtp_password
# 587 negotiates STARTTLS; set true only for an implicit-TLS port such as 465.
SMTP_SECURE=false
# Development escape hatch for a self-signed certificate. Never true in production.
SMTP_ALLOW_INVALID_CERTS=false

# ---------- MailerCloud (alternative transport) ----------
MAILERCLOUD_API_KEY=your_mailercloud_api_key
MAILERCLOUD_API_URL=https://cloudapi.mailercloud.com/v1

# ---------- Sender identity ----------
FROM_NAME="New Loans"
FROM_EMAIL=no-reply@newloans.com
MAIL_REPLY_TO=support@newloans.com
# Set true to log envelopes to the console instead of sending (local dev)
MAIL_DRY_RUN=true

# ---------- Drip / lifecycle timing ----------
# Bank-verification drip after Step 3: one email per offset, in hours from
# submission. The default sends the first immediately on submit and one every
# twelve hours after that - six emails across three days.
DRIP_OFFSET_HOURS=0,12,24,36,48,60
# How often the drip runner looks for due rows, and how many it takes a tick
DRIP_RUNNER_INTERVAL_SECONDS=60
DRIP_RUNNER_BATCH_SIZE=25
# Send attempts per email before the row is marked failed, and the gap between
DRIP_MAX_ATTEMPTS=3
DRIP_RETRY_DELAY_MINUTES=15
# Abandonment resume email delay (minutes)
RESUME_NUDGE_MINUTES=60

# ---------- Policy ----------
DECLINE_LOCKOUT_DAYS=90

# Temporary: let every applicant through to Step 3 and submit their details.
# The rules still run and record what they found; nothing is declined and the
# 90-day lockout is not enforced. Set to false to restore real decisioning.
ALLOW_ALL_TO_FINAL_STEP=true
AFFORDABILITY_PTI_MAX=0.15
DEFAULT_APR=10
RESUME_TOKEN_TTL_DAYS=30
# Retention purge (days after decision) for SSN / DL / bank data
PURGE_DECLINED_AFTER_DAYS=180
